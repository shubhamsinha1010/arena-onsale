# App talks to Postgres through PgBouncer (transaction pooling).
DATABASE_URL=postgresql+asyncpg://arena:arena@127.0.0.1:6432/arena

# Migrations must bypass PgBouncer so Alembic can use prepared statements.
DATABASE_ADMIN_URL=postgresql+asyncpg://arena:arena@127.0.0.1:5432/arena

REDIS_URL=redis://127.0.0.1:6379/0

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=5
